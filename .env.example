# Örnek ayar dosyası. Gerçek değerler `.env.<kip>.local` dosyasına yazılır; o dosya depoya girmez.
# Yerel arka uçla çalışmak için bu dosyayı `.env.yerel.local` adıyla kopyalayın.
# Sonra `npm run dev:yerel` çalıştırın. Panel http://localhost:5180 adresinde açılır.
# Buraya gizli değer yazılmaz. VITE_ değişkenleri tarayıcıya gider.

# Sahte sunucu (MSW) kapalı olur. Panel gerçek arka uca bağlanır.
VITE_API_MOCKS=off

# Kiracı sitesinin arka uç adresi. Frappe yolları (/api, /login, /assets, /files ...) buraya vekille gider.
# Tarayıcı aynı kökte kalır. VITE_SITE_URL boş bırakılır.
VITE_DEV_BACKEND=http://127.0.0.1:7401

# Frappe socket.io adresi. Boşsa socket.io da VITE_DEV_BACKEND adresine gider.
VITE_DEV_SOCKET=http://127.0.0.1:7402

# Frappe site adı. Arka uç birden çok site sunuyorsa X-Frappe-Site-Name başlığıyla gönderilir.
VITE_DEV_SITE_NAME=tenant1.localhost

# Host başlığı: "browser" tarayıcının kökünü korur (varsayılan), "target" arka ucun adresini gönderir.
VITE_DEV_BACKEND_HOST=browser

# Keycloak kökü ve realm adı. Çıkış adresi bu kökle denetlenir.
# Yerel arka uç çıkış adresini yerel Keycloak kökünde verir. Bu satır boş kalırsa üretim kökü
# (https://api.login.atonota.net) kullanılır. O zaman çıkış Keycloak'a gitmez ve Keycloak oturumu açık kalır.
VITE_KEYCLOAK_URL=http://identity.localhost:7400
VITE_KEYCLOAK_REALM=platform

# Model geçidindeki "AI Route" kaydının adı. Boşsa yapay zekâ kapalıdır.
VITE_AI_ROUTE=
