{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vite",
    "playwright.config.ts",
    "playwright.gercek.config.ts",
    "eslint.config.js",
    "tests/e2e",
    "scripts",
    "src/**/*.node.test.ts"
  ]
}
